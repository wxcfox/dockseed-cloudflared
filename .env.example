# 复制为 .env 后修改 DOMAIN；首次 init 时保持 TUNNEL_ID 为空。
# TUNNEL_ID 不是密钥；真正的密钥保存在 secrets/tunnel.json。
DOMAIN=domain.com
TUNNEL_ID=

# cloudflared 完整镜像引用；升级时修改 tag。
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.3

# Tunnel 传输协议：可选 auto、quic 或 http2。
CLOUDFLARED_PROTOCOL=auto

# 与其他 Docker 工程共享的外部网络。
GATEWAY_NETWORK=dockseed-gateway
